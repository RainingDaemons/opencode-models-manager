{
    "name": "opencode-models-manager",
    "version": "2.0.0",
    "type": "module",
    "description": "OpenCode plugin — manage agent models from a single JSON file",
    "author": "RainingDaemons",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RainingDaemons/opencode-models-manager.git"
    },
    "bugs": {
        "url": "https://github.com/RainingDaemons/opencode-models-manager/issues"
    },
    "homepage": "https://github.com/RainingDaemons/opencode-models-manager",
    "keywords": [
        "opencode",
        "opencode-plugin",
        "models",
        "agents",
        "config",
        "model-manager"
    ],
    "engines": {
        "opencode": ">=2.0.0"
    },
    "main": "./src/models.ts",
    "exports": {
        ".": "./src/models.ts"
    },
    "files": [
        "src",
        "assets",
        "!test",
        "!test/**"
    ],
    "scripts": {
        "test": "node --test test/models.test.ts",
        "typecheck": "tsc --noEmit",
        "logo": "node script/logo.mjs"
    },
    "peerDependencies": {
        "@opencode/plugin": "^2.0.0",
        "effect": "^4.0.0"
    },
    "devDependencies": {
        "@opencode/plugin": "^2.2.5",
        "@types/node": "^24.0.0",
        "effect": "4.0.6",
        "typescript": "^6.0.0"
    }
}
